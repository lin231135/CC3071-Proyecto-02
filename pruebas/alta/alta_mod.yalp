/* Parser Alta MODIFICADO: lenguaje imperativo con if-do-else */

/* ── Sección de TOKENS ── */
%token ID NUM PLUS MINUS TIMES LT GT EQ ASSIGN SEMI IF DO ELSE WHILE BEGIN END WS
IGNORE WS

%%

/* ── Sección de PRODUCCIONES ── */
programa:
    bloque
;
bloque:
    BEGIN lista_stmt END
;
lista_stmt:
    lista_stmt SEMI stmt
  | stmt
;
stmt:
    asign
  | if_stmt
  | while_stmt
;
asign:
    ID ASSIGN expr
;
if_stmt:
    IF cond DO bloque ELSE bloque
  | IF cond DO bloque
;
while_stmt:
    WHILE cond DO bloque
;
cond:
    expr LT expr
  | expr GT expr
  | expr EQ expr
;
expr:
    expr PLUS term
  | expr MINUS term
  | term
;
term:
    term TIMES factor
  | factor
;
factor:
    NUM
  | ID
;
