/* Parser Media MODIFICADO: expresiones aritméticas + instrucción print */

/* ── Sección de TOKENS ── */
%token ID NUM PLUS MINUS TIMES DIV LPAREN RPAREN ASSIGN SEMI PRINT WS
IGNORE WS

%%

/* ── Sección de PRODUCCIONES ── */
programa:
    lista_stmt
;
lista_stmt:
    lista_stmt stmt
  | stmt
;
stmt:
    ID ASSIGN expr SEMI
  | PRINT LPAREN expr RPAREN SEMI
;
expr:
    expr PLUS term
  | expr MINUS term
  | term
;
term:
    term TIMES factor
  | term DIV factor
  | factor
;
factor:
    LPAREN expr RPAREN
  | NUM
  | ID
;
